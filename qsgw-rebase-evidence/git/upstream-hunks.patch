+    assert(ctx.kspace_return_lattice.at({1, 0}) == Vector3_Order<int>(0, -3, -1));
+    assert(ctx.kstars.at(0).members.at(0).atom_rotations.at(0).atom_to == 0);
+    assert(ctx.kstars.at(0).members.at(0).atom_rotations.at(1).atom_to == 1);
