+    member.k_bz = {0.0, 0.0, 0.0};
+
+    SymmetryKAtomRotation atom_0;
+    atom_0.atom_from = 0;
+    atom_0.atom_to = 1;
+    atom_0.atom_type = 0;
+    atom_0.lmax = 0;
+    atom_0.bloch_rsh_rotations[0] = ComplexMatrix(1, 1);
